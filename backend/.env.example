# DeviceVault backend configuration.
# Copy to backend/.env and adjust. Environment variables override these values.

# SQLite database file (relative to the backend folder)
DATABASE_URL=sqlite:///./device_inventory.db

# REQUIRED in production: a long random string used to sign JWTs.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Only needed when the frontend is served from a different origin than the API.
# Behind nginx (same origin) this can stay as-is.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Create the demo accounts and sample devices on first start.
SEED_ON_STARTUP=true
